<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      刻意只宣告 INTERNET 一個權限。

      沒有 CAMERA 是故意的：拍照交給系統相機 App（ActivityResultContracts.TakePicture），
      掃條碼交給 Play 服務的 Google Code Scanner，兩者都在別的行程裡取景，
      本 app 只拿結果，因此完全不需要執行階段權限請求。
      相簿選圖走 PickVisualMedia，也不需要讀取儲存空間的權限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Health Connect（健康連線）：將飲食記錄同步至系統與 Samsung Health，並讀取運動消耗熱量 -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- 三星不保證會寫「活動大卡」，很多機種只同步步數與總消耗。
         這兩個是 readDailyActivity 的退路，少了它們那些機種的運動消耗永遠是 0。 -->
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- 體能訓練（重訓、跑步、健走等專項運動場次） -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NutriLog">

        <!--
          **桌面入口不在 MainActivity 身上，而是底下那排 activity-alias。**

          Android 不讓 app 在執行時換掉自己的 launcher 圖示：圖示是編譯進 APK 的
          資源，系統只認資源 ID。唯一的作法是事先放好幾個 alias、各自指定 icon，
          再用 PackageManager 開一個關其他（見 AppIconSwitcher）。

          MainActivity 因此不能再帶 MAIN/LAUNCHER —— 兩邊都有的話桌面會出現兩顆。
          代價是**從舊版升上來時，之前釘在桌面的捷徑會失效**（它記的是
          MainActivity 這個元件），要重新從 app 抽屜拉一次。這條路沒有別的走法。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NutriLog">
            <!-- Health Connect (Android 13 及以下之權限說明進入點) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          可切換的圖示。**永遠只有一個是 enabled**，預設是 .IconDefault。
          新增一款要同時動三個地方：這裡、AppIcon enum、以及外觀頁的清單。

          外觀頁上的排列順序看的是 AppIcon enum 的宣告順序，不是這裡的順序。
        -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconInk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:roundIcon="@mipmap/ic_launcher_ink"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconVermilion"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vermilion"
            android:roundIcon="@mipmap/ic_launcher_vermilion"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBowl"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bowl"
            android:roundIcon="@mipmap/ic_launcher_bowl"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconCat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cat"
            android:roundIcon="@mipmap/ic_launcher_cat"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconHat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hat"
            android:roundIcon="@mipmap/ic_launcher_hat"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconKeyboard"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_keyboard"
            android:roundIcon="@mipmap/ic_launcher_keyboard"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Health Connect (Android 14+ 系統隱私設定中的權限說明進入點) -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          TakePicture 要把照片寫到「我們指定的 URI」，而 file:// 從 Android 7 起
          丟給別的 App 就會 FileUriExposedException。必須透過 FileProvider
          換成 content://，並靠 grantUriPermissions 讓相機 App 有權寫入。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
